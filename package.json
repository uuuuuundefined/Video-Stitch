{
  "name": "video-stitch",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write src scripts package.json tsconfig.json vite.config.ts index.html",
    "format:check": "prettier --check src scripts package.json tsconfig.json vite.config.ts index.html",
    "tauri": "node scripts/tauri.mjs",
    "desktop": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "rust": "node scripts/rust.mjs",
    "test:core": "node scripts/rust.mjs test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:media": "node scripts/media-tests.mjs",
    "bindings": "node scripts/rust.mjs test --manifest-path src-tauri/Cargo.toml --no-default-features export_contracts",
    "media:prepare": "node scripts/prepare-media.mjs",
    "media:sources": "node scripts/fetch-media.mjs",
    "media:build:mac": "sh scripts/build-ffmpeg-macos.sh",
    "media:build:windows": "sh scripts/build-ffmpeg-windows.sh",
    "test:media-components": "node --test scripts/media-components.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.21",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
